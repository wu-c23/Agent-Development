# ============================================================
# 统一环境变量配置 — 所有模块共用
# 位置: Safe-Search Architect/.env.example
# 复制为 .env 并填入真实的 DeepSeek API Key
# ============================================================

# DeepSeek API (所有模块共用)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-pro

# ----------------------------------------------------------
# Safe-Search Architect (语义搜索)
# ----------------------------------------------------------
# Embedding provider: "local" (sentence-transformers, no API cost) or "api" (OpenAI-compatible)
EMBEDDING_PROVIDER=local
# HuggingFace mirror (国内用户建议使用镜像)
HF_ENDPOINT=https://hf-mirror.com
# Local embedding model
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
# API embedding settings (used when EMBEDDING_PROVIDER=api)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.deepseek.com
EMBEDDING_API_MODEL=text-embedding-3-small
# ChromaDB persistence directory
CHROMA_PERSIST_DIR=data/chroma

# ----------------------------------------------------------
# Sentiment Critic (舆情分析) — 共用 DeepSeek API
# ----------------------------------------------------------
# LLM 调用超时 (秒)
LLM_TIMEOUT=180
# LLM 调用重试次数
LLM_RETRIES=2
# 批量分析间隔 (秒)
LLM_BATCH_DELAY=8

# ----------------------------------------------------------
# Trend Explorer (趋势分析) — 可选，共用 DeepSeek API
# ----------------------------------------------------------
# LLM 温度参数
NOVEL_TREND_LLM_TEMPERATURE=0.2

# ----------------------------------------------------------
# 爬虫 Cookie (可选 — 仅真实采集时需要)
# ----------------------------------------------------------
TIEBA_COOKIE=
DOUBAN_COOKIE=
XHS_COOKIE=
SENTIMENT_CRITIC_UA=
