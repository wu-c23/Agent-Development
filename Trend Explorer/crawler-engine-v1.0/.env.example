LOG_LEVEL=INFO
ROBOTSTXT_OBEY=true
DOWNLOAD_DELAY=2.0
RANDOMIZE_DOWNLOAD_DELAY=true
CONCURRENT_REQUESTS=4
AUTOTHROTTLE_ENABLED=true
AUTOTHROTTLE_START_DELAY=2.0
AUTOTHROTTLE_MAX_DELAY=12.0
RETRY_TIMES=2
MAX_PAGES_PER_LIST=10
DEFAULT_PAGE_SIZE=20

PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=15000
PLAYWRIGHT_WAIT_UNTIL=domcontentloaded
PLAYWRIGHT_POST_LOAD_WAIT_MS=1500
PLAYWRIGHT_SCROLL_TIMES=1
PLAYWRIGHT_SCROLL_DELAY_MS=800
PLAYWRIGHT_BLOCK_RESOURCE_TYPES=image,media,font

OUTPUT_DIR=data
# 集中数据目录: 如需直接输出到 Sentiment Critic，可改为绝对路径
# OUTPUT_DIR=../../Sentiment Critic/data/trend_items
OUTPUT_FILE_PREFIX=trend_items
OUTPUT_INCLUDE_SPIDER=true
SAVE_RESPONSE_HTML=false
SAVE_HTML_ON_EMPTY=true
DEBUG_RESPONSE_DIR=data/debug_html

USE_REDIS_SCHEDULER=false
REDIS_PASSWORD=change-this-local-redis-password
REDIS_URL=redis://:change-this-local-redis-password@redis:6379/0

PROXY_LIST=
PROXY_POOL_URL=
QIDIAN_COOKIE=
ZONGHENG_COOKIE=
ZONGHENG_USE_API=true
ZONGHENG_DETAIL_ENABLED=true

QIDIAN_START_URLS=https://www.qidian.com/rank/yuepiao/,https://www.qidian.com/rank/hotsales/,https://www.qidian.com/rank/recom/,https://www.qidian.com/rank/readindex/
ZONGHENG_START_URLS=https://www.zongheng.com/rank?nav=monthly-ticket&rankType=1&month=20261,https://www.zongheng.com/rank?nav=monthly-ticket&rankType=1&month=20262,https://www.zongheng.com/rank?nav=monthly-ticket&rankType=1&month=20263,https://www.zongheng.com/rank?nav=monthly-ticket&rankType=1&month=20264,https://www.zongheng.com/rank?nav=monthly-ticket&rankType=1&month=20265,https://www.zongheng.com/rank?nav=one-day&rankType=3,https://www.zongheng.com/rank?nav=recommend&rankType=6,https://www.zongheng.com/rank?nav=click&rankType=5
CRAWL_INTERVAL_HOURS=72
