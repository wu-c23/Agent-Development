# Sentiment Critic 环境变量
#
# 所有模块使用统一的 API Key 配置，位于:
#   ../Safe-Search Architect/.env
#
# 本文件仅保留 Sentiment Critic 特有的可选配置。
# 如需使用真实 LLM 分析，请在 Safe-Search Architect/.env 中配置 DEEPSEEK_API_KEY。

# 爬虫 Cookie (可选 — 仅真实采集时需要)
TIEBA_COOKIE=
DOUBAN_COOKIE=
XHS_COOKIE=

# 自定义 User-Agent (可选)
SENTIMENT_CRITIC_UA=
