# DeepSeek API (required)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-pro

# Embedding provider: "local" (sentence-transformers, no API cost) or "api" (OpenAI-compatible)
EMBEDDING_PROVIDER=local

# HuggingFace mirror (国内用户建议使用镜像)
# 默认已设为 hf-mirror.com，无需修改
HF_ENDPOINT=https://hf-mirror.com

# Local embedding model (used when EMBEDDING_PROVIDER=local)
# BAAI/bge-small-zh-v1.5 is optimized for Chinese text, 512-dim, ~100MB
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# API embedding settings (used when EMBEDDING_PROVIDER=api)
# EMBEDDING_API_KEY defaults to DEEPSEEK_API_KEY if not set
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.deepseek.com
EMBEDDING_API_MODEL=text-embedding-3-small

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=data/chroma

# Review crawling (optional - for review_critic module)
DOUBAN_COOKIE=
TIEBA_COOKIE=
XHS_COOKIE=
CUSTOM_UA=
EASYCOMPUTE_BATCH_DELAY=8
