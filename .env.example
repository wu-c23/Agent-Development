# EasyCompute / OpenAI-compatible chat completions
# 复制本文件为 .env，然后把 key 替换成你的真实 key。
EASYCOMPUTE_API_KEY=your_key_here
EASYCOMPUTE_BASE_URL=https://llmapi.paratera.com/v1
EASYCOMPUTE_MODEL=DeepSeek-V4-Pro
EASYCOMPUTE_TIMEOUT=180
EASYCOMPUTE_RETRIES=2
EASYCOMPUTE_BATCH_DELAY=8

# Optional cookies for pages that require login/session.
TIEBA_COOKIE=
DOUBAN_COOKIE=
XHS_COOKIE=

# Optional custom User-Agent.
SENTIMENT_CRITIC_UA=
